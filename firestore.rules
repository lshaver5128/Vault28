rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on all collections
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow writes for authenticated users / owner operations
    match /collections/{docId} {
      allow write: if true;
    }
    match /products/{docId} {
      allow write: if true;
    }
    match /reviews/{docId} {
      allow write: if true;
    }
    match /recent_purchases/{docId} {
      allow write: if true;
    }
    match /settings/{docId} {
      allow write: if true;
    }
    match /users/{docId} {
      allow write: if true;
    }
    match /inquiries/{docId} {
      allow write: if true;
    }
    match /slideshow_images/{docId} {
      allow write: if true;
    }
    match /upcoming_shows/{docId} {
      allow write: if true;
    }
  }
}
